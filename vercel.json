{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/ledger",
      "destination": "/ledger.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
